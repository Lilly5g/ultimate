<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 1.9//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="ultimateautomizer" displayName="UAutomizer" timelimit="90s" hardtimelimit="120s" memlimit="8 GB" cpuCores="2">
  <resultfiles></resultfiles>

  <option name="--full-output"/>

  <rundefinition name="Automizer_unreach-call">
    <tasks name="nonPreprocessed">
      <includesfile>../../../trunk/examples/nonPreprocessed.set</includesfile>
      <propertyfile>../../../trunk/examples/svcomp/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="Automizer_no-overflow">  
    <tasks name="nonPreprocessed">
      <includesfile>../../../trunk/examples/nonPreprocessed.set</includesfile>
      <propertyfile>../../../trunk/examples/svcomp/properties/no-overflow.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="Automizer_no-data-race">
    <tasks name="nonPreprocessed">
      <includesfile>../../../trunk/examples/nonPreprocessed.set</includesfile>
      <propertyfile>../../../trunk/examples/svcomp/properties/no-data-race.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="Automizer_memsafety">
    <tasks name="memsafety">
      <includesfile>../../../trunk/examples/nonPreprocessed.set</includesfile>
      <propertyfile>../../../trunk/examples/svcomp/properties/valid-memsafety.prp</propertyfile>
    </tasks>
  </rundefinition>
</benchmark>
